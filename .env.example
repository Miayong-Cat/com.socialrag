# 환경변수 예시 파일 — 이 파일을 복사해서 .env 를 만들고 값을 채운다.
#   copy .env.example .env      (윈도우)
#   cp .env.example .env        (맥·리눅스)
#
# .env 는 비밀번호가 들어 있으므로 git에 올리지 않는다 (.gitignore 에 등록됨).
# 이 예시 파일(.env.example)만 올려서 "어떤 값이 필요한지" 알려 준다.
#
# 이 값을 읽는 곳:
#   - docker-compose.yml   DB 컨테이너를 만들 때 사용자·비밀번호·DB 이름·포트
#   - app/config.py        파이썬 코드가 DB에 접속할 주소(DATABASE_URL)를 만들 때
#
# 주의: 값 뒤에 주석을 붙이지 말 것 (값의 일부로 읽힐 수 있음). 주석은 항상 윗줄에.

# DB 사용자 이름
POSTGRES_USER=welfare
# DB 비밀번호 — 반드시 바꿀 것
POSTGRES_PASSWORD=change-me
# DB 이름
POSTGRES_DB=welfare
# DB 서버 주소 (Docker를 이 PC에서 띄우면 localhost)
POSTGRES_HOST=localhost
# DB 포트 (PostgreSQL 기본값. 다른 프로그램이 쓰고 있으면 5433 등으로 변경)
POSTGRES_PORT=5432

# Claude API 키 — 4단계 RAG 답변 생성용 (https://console.anthropic.com 에서 발급)
#   검색만 해 볼 때(python -m app.rag.ask "…" --search-only)는 없어도 됨
ANTHROPIC_API_KEY=
